# ==============================================================================
# TickerWise Backend .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
.env.local
*.env
*.env.*
!*.env.example
!.env.example

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests, coverage & benchmarks
.coverage
.coverage.*
.pytest_cache/
htmlcov/
coverage/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Logs & Database files
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql

# Local Review & Ingestion Dumps
rejected/
*.csv

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
